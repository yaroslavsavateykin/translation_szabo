  bb(C) eq mat(delim: "(", C_11, C_12, dots.h.c, C_(1 K); C_21, C_22, dots.h.c, C_(2 K); dots.v, dots.v, , dots.v; C_(K 1), C_(K 2), dots.h.c, C_(K K))
