
#v(1cm)

#align(center)[
  #table(
    columns: (auto, 1.2fr, 1.5fr),
    align: (center, center, center),
    inset: 6pt,
    stroke: none,

    table.hline(stroke: 1pt),
    table.header([*Сокращение*], [*Английское название*], [*Русское название*]),
    table.hline(stroke: 1pt),

    [*HF*],
    [Hartree–Fock],
    [метод Хартри — Фока],
    table.hline(stroke: 0.5pt),

    [*SCF*],
    [Self-Consistent Field],
    [самосогласованное поле],
    table.hline(stroke: 0.5pt),

    [*RHF*],
    [Restricted Hartree–Fock],
    [ограниченный метод Хартри — Фока],
    table.hline(stroke: 0.5pt),

    [*UHF*],
    [Unrestricted Hartree–Fock],
    [неограниченный метод Хартри — Фока],
    table.hline(stroke: 0.5pt),

    [*ROHF*],
    [Restricted Open-Shell Hartree–Fock],
    [ограниченный метод Хартри — Фока для открытых оболочек],
    table.hline(stroke: 0.5pt),

    [*MO-LCAO*],
    [Molecular Orbital - Linear Combination of Atomic Orbitals],
    [молекулярные орбитали как линейная комбинация атомных орбиталей],
    table.hline(stroke: 0.5pt),

    [*MO*],
    [Molecular Orbital],
    [молекулярная орбиталь],
    table.hline(stroke: 0.5pt),

    [*LCAO*],
    [Linear Combination of Atomic Orbitals],
    [линейная комбинация атомных орбиталей],
    table.hline(stroke: 0.5pt),

    [*CI*],
    [Configuration Interaction],
    [конфигурационное взаимодействие],
    table.hline(stroke: 0.5pt),

    [*FCI*],
    [Full Configuration Interaction],
    [полное конфигурационное взаимодействие],
    table.hline(stroke: 0.5pt),

    [*SDCI*],
    [Singly and Doubly Excited Configuration Interaction],
    [конфигурационное взаимодействие с однократными и двукратными
