    table.hline(stroke: 0.5pt),

    [*DCI*],
    [Doubly Excited Configuration Interaction],
    [конфигурационное взаимодействие с двукратными возбуждениями],
    table.hline(stroke: 0.5pt),

    [*DQCI*],
    [Doubly and Quadruply Excited Configuration Interaction],
