      возбуждениями],
    table.hline(stroke: 0.5pt),

    [*STO*],
    [Slater-Type Orbital],
    [слейтеровская орбиталь],
    table.hline(stroke: 0.5pt),

    [*CGF*],
    [Contracted Gaussian Function],
    [контрактированная гауссова функция],
    table.hline(stroke: 0.5pt),

    [*STO-LG*],
    [Slater-Type Orbital - L Gaussian],
    [базис STO, аппроксимированный L гауссовыми функциями],
    table.hline(stroke: 0.5pt),

    [*NO*],
    [Natural Orbitals],
    [натуральные орбитали],
    table.hline(stroke: 0.5pt),

    [*CO*],
    [Canonical Orbitals],
    [канонические орбитали],
    table.hline(stroke: 0.5pt),

    [*MCSCF*],
    [Multi-Configuration Self-Consistent Field],
    [метод многоконфигурационного самосогласованного поля],
    table.hline(stroke: 0.5pt),

    [*GVB*],
    [Generalized Valence Bond],
    [обобщённый метод валентных связей],
    table.hline(stroke: 0.5pt),

    [*VB*],
    [Valence Bond],
    [метод валентных связей],
    table.hline(stroke: 0.5pt),
  )
]
