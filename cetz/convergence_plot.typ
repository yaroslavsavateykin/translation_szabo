#import "@preview/cetz:0.5.2"

// График: частичные суммы M
//   Σ_{n=2}^{M} B_o^{(n)} / β   как функция порядка M.
// Воспроизведён по исходному рисунку; стиль (толщина линий, шрифт)
// согласован с diamond_graph.typ / transition_graph.typ.
// Использование после импорта:
//   #import "convergence_plot.typ": convergence-plot
//   #convergence-plot()
#let convergence-plot(
  unit: 0.55cm,
  line-width: 1.4pt,
  tick-label-size: 10pt,
  axis-label-size: 13pt,
  marker-radius: 0.19,
  yscale: 11.5,
) = cetz.canvas(
  length: unit,
  {
    import cetz.draw: *

    let axis-stroke = (
      paint: black,
      thickness: line-width,
      cap: "round",
      join: "round",
    )

    let curve-stroke = (
      paint: black,
      thickness: line-width,
      cap: "round",
      join: "round",
    )

    let tick-label(body) = [
      #set text(size: tick-label-size, weight: "semibold")
      #body
    ]

    let axis-label(body) = [
      #set text(size: axis-label-size, weight: "semibold")
      #body
    ]

    set-style(content: (padding: 0pt))

    // ------------------------------------------------------------------
    // Данные: (M, значение частичной суммы).
    // ------------------------------------------------------------------
    let data = (
      (2, 1.50),
      (3, 2.25),
      (4, 2.32),
      (5, 2.10),
      (6, 1.89),
      (7, 1.85),
      (8, 1.95),
      (9, 2.02),
      (10, 2.08),
      (11, 2.02),
      (12, 1.98),
      (13, 1.93),
      (14, 1.94),
      (15, 1.99),
      (16, 2.02),
      (17, 2.02),
      (18, 1.96),
    )

    // Плотный набор опорных точек (с шагом 0.5) только для построения
    // кривой — гасит паразитные изгибы/выбросы, которые даёт гладкая
    // интерполяция всего по 17 точкам с резкими перепадами. Кружки-маркеры
    // рисуются отдельно, по исходным точкам data (см. ниже).
    let curve-guide = (
      (2.00, 1.500),
      (2.20, 1.713),
      (2.40, 1.909),
      (2.60, 2.072),
      (2.80, 2.190),
      (3.00, 2.250),
      (3.20, 2.274),
      (3.40, 2.293),
      (3.60, 2.308),
      (3.80, 2.317),
      (4.00, 2.320),
      (4.20, 2.304),
      (4.40, 2.263),
      (4.60, 2.208),
      (4.80, 2.150),
      (5.00, 2.100),
      (5.20, 2.053),
      (5.40, 2.002),
      (5.60, 1.953),
      (5.80, 1.914),
      (6.00, 1.890),
      (6.20, 1.877),
      (6.40, 1.866),
      (6.60, 1.858),
      (6.80, 1.852),
      (7.00, 1.850),
      (7.20, 1.858),
      (7.40, 1.877),
      (7.60, 1.903),
      (7.80, 1.929),
      (8.00, 1.950),
      (8.20, 1.966),
      (8.40, 1.980),
      (8.60, 1.994),
      (8.80, 2.007),
      (9.00, 2.020),
      (9.20, 2.035),
      (9.40, 2.050),
      (9.60, 2.065),
      (9.80, 2.076),
      (10.00, 2.080),
      (10.20, 2.075),
      (10.40, 2.063),
      (10.60, 2.048),
      (10.80, 2.032),
      (11.00, 2.020),
      (11.20, 2.011),
      (11.40, 2.003),
      (11.60, 1.996),
      (11.80, 1.988),
      (12.00, 1.980),
      (12.20, 1.969),
      (12.40, 1.956),
      (12.60, 1.943),
      (12.80, 1.934),
      (13.00, 1.930),
      (13.20, 1.931),
      (13.40, 1.932),
      (13.60, 1.934),
      (13.80, 1.937),
      (14.00, 1.940),
      (14.20, 1.946),
      (14.40, 1.956),
      (14.60, 1.969),
      (14.80, 1.981),
      (15.00, 1.990),
      (15.20, 1.998),
      (15.40, 2.006),
      (15.60, 2.013),
      (15.80, 2.018),
      (16.00, 2.020),
      (16.20, 2.020),
      (16.40, 2.020),
      (16.60, 2.020),
      (16.80, 2.020),
      (17.00, 2.020),
      (17.20, 2.017),
      (17.40, 2.008),
      (17.60, 1.994),
      (17.80, 1.978),
      (18.00, 1.960),
    )

    // Значение по вертикали растянуто в yscale раз относительно 2.0,
    // чтобы график получился широким и плоским, как в оригинале.
    let py(v) = (v - 2.0) * yscale
    let pt(m, v) = (m, py(v))

    // ------------------------------------------------------------------
    // Оси.
    // ------------------------------------------------------------------
    let x-axis-start = 1.3
    let x-axis-end = 18.9
    let y-axis-x = 1.3
    let y-axis-bottom = py(1.45)
    let y-axis-top = py(2.47)

    // Горизонтальная ось (M), проходит на уровне значения 2.0.
    line(
      (x-axis-start, 0),
      (x-axis-end, 0),
      stroke: axis-stroke,
      mark: (end: "stealth", fill: black, scale: 1.0),
    )
    content((x-axis-end + 0.55, 0), axis-label($ M $))

    // Вертикальная ось (значение суммы).
    line(
      (y-axis-x, y-axis-bottom),
      (y-axis-x, y-axis-top),
      stroke: axis-stroke,
      mark: (end: "stealth", fill: black, scale: 1.0),
    )

    // Подпись вертикальной оси: M Σ B_o^(n)/β. Развёрнута на 90°, чтобы
    // читалась вдоль оси; сдвинута дальше влево от делений/цифр.
    content(
      (y-axis-x - 2.90, 0),
      axis-label($ sum_(n=2)^(M) B_o^((n)) / beta $),
      angle: 90deg,
    )

    // ------------------------------------------------------------------
    // Деления и подписи горизонтальной оси (M = 2..18).
    // ------------------------------------------------------------------
    for m in range(2, 19) {
      line((m, -0.10), (m, 0.10), stroke: axis-stroke)
      if calc.rem(m, 2) == 0 and m <= 16 {
        content((m, -0.55), tick-label(str(m)))
      }
    }

    // ------------------------------------------------------------------
    // Деления и подписи вертикальной оси (значение = 1.5..2.4).
    // ------------------------------------------------------------------
    let y-ticks = (1.5, 1.6, 1.7, 1.8, 1.9, 2.0, 2.1, 2.2, 2.3, 2.4)
    let y-tick-labels = (
      "1.5",
      "1.6",
      "1.7",
      "1.8",
      "1.9",
      "2",
      "2.1",
      "2.2",
      "2.3",
      "2.4",
    )
    for i in range(0, y-ticks.len()) {
      let v = y-ticks.at(i)
      line(
        (y-axis-x - 0.12, py(v)),
        (y-axis-x + 0.12, py(v)),
        stroke: axis-stroke,
      )
      content(
        (y-axis-x - 0.70, py(v)),
        tick-label(y-tick-labels.at(i)),
      )
    }

    // ------------------------------------------------------------------
    // Гладкая кривая через экспериментальные точки.
    // ------------------------------------------------------------------
    let curve-points = curve-guide.map(d => pt(d.at(0), d.at(1)))
    line(..curve-points, stroke: curve-stroke)

    // ------------------------------------------------------------------
    // Маркеры данных.
    // ------------------------------------------------------------------
    for d in data {
      circle(
        pt(d.at(0), d.at(1)),
        radius: marker-radius,
        fill: black,
        stroke: none,
      )
    }
  },
)
